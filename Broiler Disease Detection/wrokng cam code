//------------------------------------------------LOOP ------------------------------------------------
void loop() {
  unsigned long currentTime = millis();

  if (currentTime - lastPingTime >= pingInterval) {
     Serial.println("Sending PIng.");
    sendPing();
    lastPingTime = currentTime;
  }
  
 if (!isCaptureCycleActive && (currentTime - lastCaptureCycleEndTime >= captureCycleInterval || lastCaptureCycleEndTime == 0)) {
    Serial.println("Starting new capture cycle...");
    
    isCaptureCycleActive = true;
    currentPosition = 0; 
    lastCaptureTime = currentTime; 
    captureImage();
  }
  
  else if (isCaptureCycleActive && currentTime - lastCaptureTime >= captureDelay && currentPosition < 3) {
    captureImage();
  }
  
  else if (isCaptureCycleActive && currentPosition >= 3) {
    Serial.println("Capture cycle complete.");
    
    isCaptureCycleActive = false; 
    lastCaptureCycleEndTime = currentTime; 
    Serial.println("Moving back to Position 0.");
//    myServo.write(0);
    // processAndSendImages(); 
  }
 
  
  delay(10);
}


void captureImage() {
    int targetPos = servoPositions[currentPosition];
    Serial.printf("Moving servo to position %d degrees\n", targetPos);
    myServo.write(targetPos);
    delay(servoDelay);
    Serial.printf(" At position %d degrees Capturing image... \n", targetPos);
    camera_fb_t *fb = esp_camera_fb_get();
    
    if (WiFi.status() == WL_CONNECTED) {
      Serial.print("Sendig to Django");
        sendImageToDjango(fb);
    }
    esp_camera_fb_return(fb);
    if (fb) {
        capturedImages[currentPosition] = fb;
        Serial.printf("Captured image %d size: %u bytes\n", currentPosition, fb->len);
        currentPosition++;
        lastCaptureTime = millis();
    } else {
        Serial.println("Camera capture failed");
         SerialPort.println("CAPTURE_FAILED");
        isCaptureCycleActive = false; 
    }
}


void printMemoryInfo() {
  Serial.println("===== MEMORY INFO =====");

  // DRAM - main heap
  Serial.printf("Free DRAM (heap): %d bytes\n", heap_caps_get_free_size(MALLOC_CAP_DEFAULT));

  // PSRAM - external SPI RAM
  if (psramFound()) {
    Serial.printf("Free PSRAM (SPIRAM): %d bytes\n", heap_caps_get_free_size(MALLOC_CAP_SPIRAM));
    Serial.printf("Total PSRAM: %d bytes\n", ESP.getPsramSize());
  } else {
    Serial.println("PSRAM not found.");
  }

  // IRAM - fast instruction RAM
  Serial.printf("Free IRAM: %d bytes\n", heap_caps_get_free_size(MALLOC_CAP_EXEC));

  // Flash info (Arduino-friendly)
  uint32_t flash_size = ESP.getFlashChipSize();
  Serial.printf("Total Flash Size: %d bytes (%.2f MB)\n", flash_size, flash_size / (1024.0 * 1024));
  Serial.printf("Sketch Size: %u bytes\n", ESP.getSketchSize());
  Serial.printf("Free Flash Space: %u bytes\n", ESP.getFreeSketchSpace());

  Serial.println("========================");
}


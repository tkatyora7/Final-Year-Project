  setupTFModel();



  // Initialize servo
  ESP32PWM::allocateTimer(0);
  ESP32PWM::allocateTimer(1);
  ESP32PWM::allocateTimer(2);
  ESP32PWM::allocateTimer(3);
  
  myServo.setPeriodHertz(50);
  myServo.attach(SERVO_PIN, 500, 2400);
  myServo.write(0);
  delay(1000);


  // Camera configuration
  camera_config_t config;
  config.ledc_channel = LEDC_CHANNEL_0;
  config.ledc_timer = LEDC_TIMER_0;
  config.pin_d0 = Y2_GPIO_NUM;
  config.pin_d1 = Y3_GPIO_NUM;
  config.pin_d2 = Y4_GPIO_NUM;
  config.pin_d3 = Y5_GPIO_NUM;
  config.pin_d4 = Y6_GPIO_NUM;
  config.pin_d5 = Y7_GPIO_NUM;
  config.pin_d6 = Y8_GPIO_NUM;
  config.pin_d7 = Y9_GPIO_NUM;
  config.pin_xclk = XCLK_GPIO_NUM;
  config.pin_pclk = PCLK_GPIO_NUM;
  config.pin_vsync = VSYNC_GPIO_NUM;
  config.pin_href = HREF_GPIO_NUM;
  config.pin_sccb_sda = SIOD_GPIO_NUM;
  config.pin_sccb_scl = SIOC_GPIO_NUM;
  config.pin_pwdn = PWDN_GPIO_NUM;
  config.pin_reset = RESET_GPIO_NUM;
  config.xclk_freq_hz = 20000000;
  config.pixel_format = PIXFORMAT_JPEG; 
 config.frame_size = FRAMESIZE_SVGA;  
  config.jpeg_quality = 10;           
  config.fb_count = 1;

  esp_err_t err = esp_camera_init(&config);
  if (err != ESP_OK) {
    Serial.printf("Camera init failed with error 0x%x\n", err);
    if (err == ESP_ERR_CAMERA_NOT_DETECTED) {
      Serial.println("Camera not detected! Check wiring.");
    }
    ESP.restart();
  }

  sensor_t *s = esp_camera_sensor_get();
  if (s != nullptr) {
    s->set_vflip(s, 1);
    s->set_hmirror(s, 1);
  }

  WiFi.begin(ssid, password);
  Serial.print("Connecting to WiFi...");
  
  int attempts = 0;
  while (WiFi.status() != WL_CONNECTED && attempts < 20) {
    delay(500);
    Serial.print(".");
    attempts++;
  }
  
  if (WiFi.status() == WL_CONNECTED) {
    Serial.println("\nWiFi connected");
    Serial.print("IP address: ");
    Serial.println(WiFi.localIP());
    sendPing();
    lastPingTime = millis();
  } else {
    Serial.println("\nFailed to connect to WiFi");
  }
  Serial.printf("Free Memory: %d bytes\n", esp_get_free_heap_size());
  
  printMemoryInfo();

}
//------------------------------------------------LOOP ------------------------------------------------
void loop() {
  unsigned long currentTime = millis();
  
  if (currentTime - lastPingTime >= pingInterval) {
    sendPing();
    lastPingTime = currentTime;
  }
  if (!isCaptureCycleActive && (currentTime - lastCaptureCycleEndTime >= captureCycleInterval || lastCaptureCycleEndTime == 0)) {
    Serial.println("Starting new capture cycle...");
    isCaptureCycleActive = true;
    currentPosition = 0; 
    lastCaptureTime = currentTime; 
    moveServoAndCapture();
  }
  
  else if (isCaptureCycleActive && currentTime - lastCaptureTime >= captureDelay && currentPosition < 3) {
    moveServoAndCapture();
  }
  
  else if (isCaptureCycleActive && currentPosition >= 3) {
    Serial.println("Capture cycle complete.");
    isCaptureCycleActive = false; 
    lastCaptureCycleEndTime = currentTime; 
    Serial.println("Moving back to Position 0.");
    myServo.write(0);
    // processAndSendImages(); 
  }

